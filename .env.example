# ── LLM / Embedding Provider ─────────────────────────────────────────────────
# For embeddings: "openai" or "local"
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=sk-proj-your-key-here

# ── Embedding Model ───────────────────────────────────────────────────────────
# OpenAI:  text-embedding-3-small (1536-dim, cheap)  |  text-embedding-3-large (3072-dim)
# Local:   all-MiniLM-L6-v2 (384-dim, free)          |  all-mpnet-base-v2 (768-dim, free)
# WARNING: changing this after indexing data requires re-indexing everything!
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ── Vector Store ──────────────────────────────────────────────────────────────
CHROMA_PATH=./chroma_db

# ── Search Settings ───────────────────────────────────────────────────────────
TOP_K=5
SIMILARITY_THRESHOLD=0.65

# ── Privacy / MLOps ───────────────────────────────────────────────────────────
# Set to "true" to redact PII before embedding (recommended for production)
REDACT_PII=true
# Set to "false" to disable query logging
ENABLE_QUERY_LOGGING=true
QUERY_LOG_PATH=./logs/queries.jsonl

# ── Server ────────────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
